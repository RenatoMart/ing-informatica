APP_ENV=testing
# Generar con: php artisan key:generate --env=testing --show  (y pegar aqui en .env.testing)
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# BD de pruebas: PostgreSQL con el schema `pruebas` (nunca el schema/rama de produccion).
# tests/TestCase.php se niega a correr si el search_path empieza por `public`.
DB_CONNECTION=pgsql
DB_URL=
DB_SSLMODE=require
DB_SEARCH_PATH=pruebas

SESSION_DRIVER=database
MAIL_MAILER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
FILESYSTEM_DISK_PUBLICO=public

PORTAL_DOMINIO_CORREO=unitru.edu.pe
